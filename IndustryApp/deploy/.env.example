# Üretim ayarları (SDD 15.1). Repo kökündeki (IndustryApp/) .env dosyasına kopyalayıp doldurun; .env repoya girmez.

# Sitenin alan adı; A kaydı sunucuyu göstermeli. Caddy sertifikayı bu ad için alır.
DOMAIN=industryapp.example.com

# PostgreSQL parolası (db konteyneri ve API bağlantısı aynı değeri kullanır).
DB_PASSWORD=

# JWT imza anahtarı: openssl rand -base64 64 | tr -d '\n'
JWT_SIGNING_KEY=

# SMTP hesabı (587, STARTTLS).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
