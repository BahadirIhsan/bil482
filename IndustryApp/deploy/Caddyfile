# IndustryApp reverse proxy (SDD 15.2). DOMAIN .env'den gelir; sertifika Let's Encrypt'ten otomatik alınır ve yenilenir.
# DOMAIN verilmezse localhost için Caddy'nin yerel sertifikası kullanılır (yalnızca deneme).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API, SignalR hub'ı ve sağlık kontrolü. WebSocket yükseltmesini reverse_proxy kendisi taşır.
	@backend path /api/* /hubs/* /health
	handle @backend {
		# Fotoğraf yükleme sınırı (10 MB) + multipart payı; API ayrıca kendi sınırını uygular.
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8080
	}

	# SPA: derlenmiş dosyalar; bilinmeyen yol index.html'e düşer (istemci tarafı yönlendirme).
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
