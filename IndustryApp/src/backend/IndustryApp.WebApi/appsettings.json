{
  "ConnectionStrings": {
    "Default": "Host=db;Database=industryapp;Username=industryapp;Password=__ENV__"
  },
  "Jwt": {
    "Issuer": "industryapp",
    "Audience": "industryapp-clients",
    "SigningKey": "__ENV__",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "https://industryapp.com" ]
  },
  "Storage": {
    "RootPath": "/data/uploads"
  },
  "Photos": {
    "MaxCountPerReport": 8,
    "MaxFileSizeMb": 10,
    "MaxWidthPx": 1920,
    "JpegQuality": 80,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/heic", "image/webp" ]
  },
  "Reports": {
    "ExpireAfterHours": 72,
    "MaxOpenPerCustomer": 3
  },
  "Offers": {
    "SelectionUndoWindowMinutes": 10
  },
  "Matching": {
    "Strategy": "CITY",
    "DefaultRadiusKm": 15,
    "MaxMechanicsPerReport": 20,
    "Filters": [ "ApprovedAndActive", "Specialty", "Availability", "DailyCapacity" ]
  },
  "Email": {
    "Host": "__ENV__",
    "Port": 587,
    "UseStartTls": true,
    "User": "__ENV__",
    "Password": "__ENV__",
    "FromAddress": "bildirim@industryapp.com",
    "FromName": "IndustryApp"
  },
  "Resilience": {
    "Email": {
      "RetryCount": 3,
      "BreakDurationSeconds": 60,
      "FailureRatio": 0.5,
      "SamplingSeconds": 30,
      "MinimumThroughput": 5,
      "TimeoutSeconds": 10
    }
  },
  "RateLimiting": {
    "LoginPerMinute": 5,
    "RegisterPerMinute": 3,
    "UploadPerMinute": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
